# Copy this file to .env in src/backend and replace the placeholder values.
MYSQL_URL=jdbc:mysql://localhost:3307/fitsync?createDatabaseIfNotExist=true
MYSQL_USER=fitsync_app
MYSQL_PASSWORD=replace-with-your-local-mysql-password

# Generate a unique random value with at least 32 characters. Do not commit .env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=900000
PORT=8080
