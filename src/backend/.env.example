# Copy this file to the repository root as .env and replace the placeholder values.
FITSYNC_DB_URL=jdbc:mysql://localhost:3307/fitsync?createDatabaseIfNotExist=true
FITSYNC_DB_USER=fitsync_app
FITSYNC_DB_PASSWORD=replace-with-your-local-mysql-password

# Generate a unique random value with at least 32 characters. Do not commit .env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
PORT=8080
FITSYNC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
