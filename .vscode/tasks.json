{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FitSync Backend",
			"type": "shell",
			"command": "mvn.cmd spring-boot:run",
			"options": {
				"cwd": "${workspaceFolder}\\src\\backend"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "FitSync Frontend",
			"type": "shell",
			"command": "npm.cmd run dev -- --host localhost",
			"options": {
				"cwd": "${workspaceFolder}\\src\\web"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}